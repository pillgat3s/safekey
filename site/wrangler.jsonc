{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safekey-site",
  "account_id": "0d2872e191d5028670167647f06a8a63",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "safekey.tws.sh", "custom_domain": true }
  ]
}
